# Application
APP_NAME=ipo-intelligence-agent
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ipo_intelligence
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# Vector Database
VECTOR_DB_PROVIDER=pgvector
PGVECTOR_CONNECTION_STRING=postgresql+asyncpg://postgres:postgres@localhost:5432/ipo_intelligence
CHROMA_HOST=localhost
CHROMA_PORT=8000
WEAVIATE_URL=http://localhost:8080
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=ipo-intelligence

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=1800
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# Prefect
PREFECT_API_URL=http://localhost:4200/api
PREFECT_API_KEY=

# AI Models
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LLAMA_MODEL_PATH=./models/llama-3.1-70b-instruct.Q4_K_M.gguf

# Embedding Models
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
SENTENCE_TRANSFORMER_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# LLM Configuration
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o
DEFAULT_TEMPERATURE=0.1
DEFAULT_MAX_TOKENS=4096
DEFAULT_TOP_P=0.9

# Agent Configuration
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=300
AGENT_RETRY_ATTEMPTS=3
AGENT_RETRY_DELAY_SECONDS=5

# Discovery Agent
DISCOVERY_SOURCES=sec,nasdaq,nyse,lse,hkex,bse,nse
DISCOVERY_POLL_INTERVAL_MINUTES=15
DISCOVERY_LOOKAHEAD_DAYS=90

# Collection Agent
COLLECTION_TIMEOUT_SECONDS=120
COLLECTION_MAX_CONCURRENT=10
COLLECTION_RETRY_ATTEMPTS=3
FINANCIAL_DATA_PROVIDERS=yfinance,alpha_vantage,openbb,sec_edgar
NEWS_PROVIDERS=bloomberg,reuters,financial_times,seeking_alpha
SOCIAL_PROVIDERS=twitter,reddit,stocktwits,linkedin

# Analysis Agents
FUNDAMENTAL_ANALYSIS_DEPTH=comprehensive
MARKET_ANALYSIS_DEPTH=comprehensive
RISK_ANALYSIS_DEPTH=comprehensive
SENTIMENT_ANALYSIS_DEPTH=comprehensive

# Scoring Weights
SCORE_FINANCIAL_STRENGTH_WEIGHT=0.25
SCORE_GROWTH_POTENTIAL_WEIGHT=0.25
SCORE_MARKET_OPPORTUNITY_WEIGHT=0.20
SCORE_MANAGEMENT_QUALITY_WEIGHT=0.15
SCORE_RISK_LEVEL_WEIGHT=0.15

# Memory
MEMORY_VECTOR_DIMENSION=1024
MEMORY_SIMILARITY_THRESHOLD=0.75
MEMORY_MAX_RESULTS=10
MEMORY_TTL_DAYS=365

# Reflection
REFLECTION_ENABLED=true
REFLECTION_MIN_OUTCOME_DELAY_DAYS=30
REFLECTION_ACCURACY_THRESHOLD=0.7
REFLECTION_BATCH_SIZE=50

# Failure Memory
FAILURE_SIMILARITY_THRESHOLD=0.8
FAILURE_MAX_HISTORY=1000

# Success Memory
SUCCESS_SIMILARITY_THRESHOLD=0.75
SUCCESS_MIN_CONFIDENCE=0.8

# External APIs
ALPHA_VANTAGE_API_KEY=
BLOOMBERG_API_KEY=
REUTERS_API_KEY=
FINANCIAL_TIMES_API_KEY=
SEEKING_ALPHA_API_KEY=
TWITTER_API_KEY=
TWITTER_API_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
STOCKTWITS_API_KEY=
LINKEDIN_API_KEY=

# SEC EDGAR
SEC_EDGAR_USER_AGENT=IPO Intelligence Agent/1.0
SEC_EDGAR_RATE_LIMIT=10

# Monitoring
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ipo-intelligence-agent
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_METRICS_EXPORTER=prometheus
PROMETHEUS_PORT=9090
GRAFANA_URL=http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/app.log
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=10

# Security
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=[".pdf",".xlsx",".csv",".txt",".json"]

# Email (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Webhooks
WEBHOOK_SECRET=
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_TIMEOUT_SECONDS=30